{
  "name": "pv-single-diode-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "教学用太阳电池单二极管静态电学分析后端（API + CLI，TypeScript + Node + SQLite）",
  "bin": {
    "pv": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "dev": "npm run build && node dist/src/server.js",
    "demo": "npm run build && node dist/scripts/demo.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:only": "node --test dist/test/*.test.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3"
  }
}
